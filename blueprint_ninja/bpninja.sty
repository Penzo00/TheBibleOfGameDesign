% bpninja.sty - nodi "Blueprint" di Unreal Engine disegnati con TikZ
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bpninja}[2026/11/24 Blueprint in TikZ]
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\usetikzlibrary{shapes.geometric,calc,positioning,backgrounds,fit}

