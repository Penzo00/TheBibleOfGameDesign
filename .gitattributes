# Normalize text files across Windows, macOS and Linux.
* text=auto

# Keep common scripts consistent across platforms.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Machine-learning models, checkpoints and numerical datasets.
*.[oO][nN][nN][xX] filter=lfs diff=lfs merge=lfs -text
*.[nN][pP][zZ] filter=lfs diff=lfs merge=lfs -text
*.[nN][pP][yY] filter=lfs diff=lfs merge=lfs -text
*.[pP][tT] filter=lfs diff=lfs merge=lfs -text
*.[pP][tT][hH] filter=lfs diff=lfs merge=lfs -text
*.[cC][kK][pP][tT] filter=lfs diff=lfs merge=lfs -text
*.[sS][aA][fF][eE][tT][eE][nN][sS][oO][rR][sS] filter=lfs diff=lfs merge=lfs -text
*.[tT][fF][lL][iI][tT][eE] filter=lfs diff=lfs merge=lfs -text
*.[gG][gG][uU][fF] filter=lfs diff=lfs merge=lfs -text
*.[jJ][oO][bB][lL][iI][bB] filter=lfs diff=lfs merge=lfs -text
*.[pP][kK][lL] filter=lfs diff=lfs merge=lfs -text
*.[hH]5 filter=lfs diff=lfs merge=lfs -text
*.[hH][dD][fF]5 filter=lfs diff=lfs merge=lfs -text
*.[kK][eE][rR][aA][sS] filter=lfs diff=lfs merge=lfs -text
*.[pP][bB] filter=lfs diff=lfs merge=lfs -text

# Scientific / columnar data.
*.[pP][aA][rR][qQ][uU][eE][tT] filter=lfs diff=lfs merge=lfs -text
*.[fF][eE][aA][tT][hH][eE][rR] filter=lfs diff=lfs merge=lfs -text
*.[aA][rR][rR][oO][wW] filter=lfs diff=lfs merge=lfs -text
*.[mM][aA][tT] filter=lfs diff=lfs merge=lfs -text

# Unreal Engine binary assets.
*.[uU][aA][sS][sS][eE][tT] filter=lfs diff=lfs merge=lfs -text
*.[uU][mM][aA][pP] filter=lfs diff=lfs merge=lfs -text
*.[uU][bB][uU][lL][kK] filter=lfs diff=lfs merge=lfs -text
*.[uU][eE][xX][pP] filter=lfs diff=lfs merge=lfs -text
*.[uU][pP][tT][nN][lL] filter=lfs diff=lfs merge=lfs -text

