# -----------------------------------------------------------------------------
# Secrets and machine-local credentials — review before use
# -----------------------------------------------------------------------------
# Environment files; allow safe examples/templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist

# Private keys / keystores. PEM files are ignored because they often contain
# private keys; force-add only when you have confirmed a PEM is public.
*.key
*.pem
!*.public.pem
!*-cert.pem
*.p12
*.pfx
*.p7b
*.p7c
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Common credential files; retain sanitized examples.
.netrc
.pypirc
.npmrc
.npmrc.*
!.npmrc.example
!.npmrc.sample
.yarnrc.yml.local
.aws/credentials
.azure/
.config/gcloud/
.kube/config
secrets.local.*
credentials.local.*
service-account*.json
*-service-account*.json
credentials.json
secrets.json
!credentials.example.json
!secrets.example.json

# Terraform state and local variable files (often contain secrets).
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.sample
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

